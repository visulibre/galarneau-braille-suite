{
  "name": "galarneau-braille-suite",
  "version": "1.0.0",
  "description": "Traducteur braille desktop Electron avec preview liblouis-js et production native liblouisutdml.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "keywords": [
    "braille",
    "electron",
    "accessibilite",
    "liblouis"
  ],
  "license": "GPL-2.0-only",
  "dependencies": {
    "jszip": "^3.10.2",
    "liblouis": "^0.4.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.visulibre.galarneau-braille-suite",
    "productName": "Galarneau Braille Suite",
    "asar": true,
    "asarUnpack": [
      "node_modules/liblouis-build/**",
      "node_modules/liblouis/**",
      "native/**"
    ],
    "files": [
      "src/**/*",
      "native/**/*",
      "package.json",
      "package-lock.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}

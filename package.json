{
  "name": "galarneau-braille-suite",
  "version": "1.0.0",
  "description": "Traducteur braille desktop basé sur Electron et liblouis-js.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "keywords": [
    "braille",
    "electron",
    "accessibilite",
    "liblouis"
  ],
  "license": "GPL-2.0-only",
  "dependencies": {
    "liblouis": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.visulibre.galarneau-braille-suite",
    "productName": "Galarneau Braille Suite",
    "asar": true,
    "asarUnpack": [
      "node_modules/liblouis-build/**",
      "node_modules/liblouis/**"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "package-lock.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}

{
  "name": "galarneau-braille-suite",
  "version": "1.0.0",
  "description": "Traducteur braille desktop Electron avec preview liblouis-js et production native liblouisutdml.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "assets:icon:win": "magick build/icons/app-icon.svg -background none -define icon:auto-resize=256,128,64,48,32,16 build/icons/app-icon.ico",
    "verify:win-signing-env": "node scripts/verify-win-signing-env.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis zip",
    "dist:win:signed": "npm run verify:win-signing-env && electron-builder --win nsis zip"
  },
  "keywords": [
    "braille",
    "electron",
    "accessibilite",
    "liblouis"
  ],
  "license": "GPL-2.0-only",
  "dependencies": {
    "jszip": "^3.10.2",
    "liblouis": "^0.4.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4"
  },
  "optionalDependencies": {
    "koffi": "^3.3.5"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.visulibre.galarneau-braille-suite",
    "productName": "Galarneau Braille Suite",
    "asar": true,
    "asarUnpack": [
      "node_modules/liblouis-build/**",
      "node_modules/liblouis/**",
      "native/**",
      "node_modules/koffi/**"
    ],
    "files": [
      "src/**/*",
      "native/**/*",
      "package.json",
      "package-lock.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icons/app-icon.ico",
      "uninstallerIcon": "build/icons/app-icon.ico",
      "installerHeaderIcon": "build/icons/app-icon.ico"
    }
  },
  "allowScripts": {
    "koffi@3.3.5": true,
    "electron-winstaller@5.4.0": true
  }
}
